<?xml version="1.0" encoding="utf-8"?>
<!--
  Same rule as the plugin's own nuget.config: packages stay inside a _packages folder next to the
  checkout instead of the machine wide %USERPROFILE%\.nuget\packages folder. The path resolves to
  the same folder as ..\nuget.config, because this file lives one level deeper (tests/).
-->
<configuration>
  <config>
    <add key="globalPackagesFolder" value="..\..\_packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
