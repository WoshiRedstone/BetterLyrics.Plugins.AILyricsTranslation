<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyName>BetterLyrics.Plugins.AILyricsTranslation.LiveHarness</AssemblyName>
		<RootNamespace>BetterLyrics.Plugins.AILyricsTranslation.LiveHarness</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<!-- Shared helpers: locates the built plugin without machine specific paths. -->
		<Compile Include="..\Shared\TestPaths.cs" Link="TestPaths.cs" />
		<PackageReference Include="BetterLyrics.Sdk" Version="1.0.3" />
		<!-- Same reason as PluginHarness: the host ships ChineseConverter.dll, so the package is trimmed. -->
		<PackageReference Include="CHTCHSConv" Version="1.0.0" />
	</ItemGroup>

</Project>
