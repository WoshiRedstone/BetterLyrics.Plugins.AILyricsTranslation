<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyName>BetterLyrics.InstallerHarness</AssemblyName>
		<RootNamespace>BetterLyrics.InstallerHarness</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<!-- Shared helpers: locates the built plugin without machine specific paths. -->
		<Compile Include="..\Shared\TestPaths.cs" Link="TestPaths.cs" />
		<!--
			BundledPluginInstaller only uses System.IO, so the host project is referenced for the
			implementation itself. The Windows specific TFMs are skipped: the harness runs on net10.0.
		-->
		<Compile Include="..\..\..\BetterLyrics-dev\BetterLyrics-dev\src\BetterLyrics.DotNet\BetterLyrics.Core\Helpers\BundledPluginInstaller.cs" Link="BundledPluginInstaller.cs" />
		<Compile Include="..\..\..\BetterLyrics-dev\BetterLyrics-dev\src\BetterLyrics.DotNet\BetterLyrics.Core\Helpers\PluginMetadataHelper.cs" Link="PluginMetadataHelper.cs" />
	</ItemGroup>

</Project>
