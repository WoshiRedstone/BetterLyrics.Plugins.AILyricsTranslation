<?xml version="1.0" encoding="utf-8"?>
<!--
  Keeps every package this plugin consumes inside the workspace itself, in a _packages folder
  next to the checkout, instead of the machine wide %USERPROFILE%\.nuget\packages folder.
  Building therefore leaves nothing behind outside this folder: no registry keys, no PATH entries
  and no shared package cache the user has to clean up.

  The path is relative to this file, so a fresh clone works anywhere. Delete the value below (or
  restore it to the default cache path) if you would rather use the shared package folder.
-->
<configuration>
  <config>
    <add key="globalPackagesFolder" value="..\_packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
